# ~/.config/zsh/aliases.zsh

alias c='clear && printf "\033[3J"'
alias clear='clear && printf "\033[3J"'
alias ls='ls --color=auto'
alias ll='ls -lha'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias v='nvim'
alias vi='nvim'
alias vim='nvim'
alias lg='lazygit'
