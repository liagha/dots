    pe_offset = struct.unpack('<I', f.read(4))[0]\
    print(f'PE signature at: 0x{pe_offset:x}')\
    \
    # Read size of optional header\
    f.seek(pe_offset + 0x14)  # 0x14 bytes into PE header\
    opt_header_size = struct.unpack('<H', f.read(2))[0]\
    print(f'Optional header size: 0x{opt_header_size:x}')\
    \
    # Section headers start after optional header\
    section_offset = pe_offset + 0x18 + opt_header_size\
    print(f'Section headers at: 0x{section_offset:x}')\
    \
    # Entry point\
    f.seek(pe_offset + 0x28)\
    entry_point = struct.unpack('<I', f.read(4))[0]\
    print(f'Entry point RVA: 0x{entry_point:x}')\
