// src/main.rs\
\
use instructor::arch::Target;\
use instructor::ir::module::Module;\
use instructor::ir::function::Function;\
use instructor::ir::block::Block;\
use instructor::ir::instruction::Instruction;\
use instructor::ir::op::Op;\
use instructor::ir::value::{Value, Width};\
use instructor::ir::lower::Lower;\
\
fn main() {\
    let mut module = Module::new();\
\
    let mut function = Function::new(0, vec![\
        Value::Virtual(0, Width::SixtyFour),\
        Value::Virtual(1, Width::SixtyFour),\
    ]);\
\
    let mut block = Block::new(0);\
\
    block.push(Instruction::new(\
        Op::Add,\
        Some(Value::Virtual(2, Width::SixtyFour)),\
        vec![\
            Value::Virtual(0, Width::SixtyFour),\
            Value::Virtual(1, Width::SixtyFour),\
        ],\
    ));\
\
    block.push(Instruction::new(\
        Op::Ret,\
        None,\
        vec![],\
    ));\
\
    function.push(block);\
    module.push(function);\
\
    for target in [Target::X86_64, Target::Arm64, Target::Riscv64] {\
        let name = format!("{:?}", target);\
        let mut lower = Lower::new(target);\
        lower.run(&module);\
        println!("=== {} ===", name);\
        println!("{}", lower.emitter.render());\
    }\
}
